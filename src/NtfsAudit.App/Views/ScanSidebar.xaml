<UserControl x:Class="NtfsAudit.App.Views.ScanSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Stato scansione" Style="{StaticResource AppGroupBoxStyle}" Margin="0">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <Border Width="14" Height="14" Background="{Binding StatusBrush}" CornerRadius="2" Margin="0,0,6,0" />
                  <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MicrocopyText}" Margin="0,0,0,6" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ServiceRuntimeStatusText}" Style="{StaticResource MicrocopyText}" Margin="0,0,0,8" TextWrapping="Wrap" />
                <Border Background="{Binding CurrentPathBackground}" Padding="6" CornerRadius="4" Margin="0,0,0,8">
                  <TextBlock Text="{Binding CurrentPathText}" TextTrimming="CharacterEllipsis" />
                </Border>
                <WrapPanel Margin="0,0,0,6">
                  <Border Padding="6,4" CornerRadius="4" Margin="0,0,8,6" Background="#FFE8F5E9">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Cartelle analizzate: " VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ProcessedCount}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border Padding="6,4" CornerRadius="4" Margin="0,0,8,6" Background="#FFE3F2FD">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="File analizzati: " VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ProcessedFilesCount}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border Padding="6,4" CornerRadius="4" Margin="0,0,8,6" Background="#FFFFEBEE">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Errori: " VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ErrorCount}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border Padding="6,4" CornerRadius="4" Margin="0,0,8,6" Background="#FFF5F5F5">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Tempo: " VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ElapsedText}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </WrapPanel>
              </StackPanel>
            </GroupBox>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
              <StackPanel>
              <GroupBox Header="Scansione" Style="{StaticResource AppGroupBoxStyle}" Margin="0" IsEnabled="{Binding IsScanConfigEnabled}" Visibility="{Binding IsNotViewerMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                  <TextBlock Text="Cartelle da scansionare" Style="{StaticResource SubsectionHeaderText}" />
                  <TextBlock Text="Aggiorna l'elenco e rilancia quando serve." Style="{StaticResource MicrocopyText}" ToolTip="Puoi fermare la scansione o il job con pulizia residui, modificare questo elenco e riavviare con nuove cartelle." />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,8,0" Content="Sfoglia..." Command="{Binding BrowseCommand}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Style="{StaticResource InlineActionButtonStyle}" Margin="8,0,0,0" Content="Aggiungi" Command="{Binding AddScanRootCommand}" />
                  </Grid>
                  <Grid Margin="0,0,0,6" Visibility="{Binding HasDfsTargets, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Target DFS input" VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="Se il percorso inserito è un namespace DFS con più target, scegli qui il target da usare prima di avviare la scansione o aggiungere la root." />
                    <ComboBox Grid.Column="1"
                              Height="28"
                              Background="#FFE3F2FD"
                              ItemsSource="{Binding DfsTargets}"
                              SelectedItem="{Binding SelectedDfsTarget, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" Height="90" ItemsSource="{Binding ScanRoots}" SelectedItem="{Binding SelectedScanRoot}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="4" Margin="0,1" CornerRadius="3" Background="{Binding Converter={StaticResource ScanRootPathKindBrushConverter}}">
                            <DockPanel>
                              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Border Background="#FF37474F" CornerRadius="8" Padding="6,1" Margin="4,0,0,0">
                                  <TextBlock Text="{Binding Converter={StaticResource ScanRootPathKindLabelConverter}}" Foreground="White" FontSize="10" />
                                </Border>
                                <Border Background="#FF6A1B9A" CornerRadius="8" Padding="6,1" Margin="4,0,0,0"
                                        Visibility="{Binding Converter={StaticResource DfsMultiServerVisibilityConverter}}">
                                  <TextBlock Text="DFS multi-server" Foreground="White" FontSize="10" />
                                </Border>
                              </StackPanel>
                              <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,6,0" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Column="1" Style="{StaticResource InlineActionButtonStyle}" Margin="8,0,0,0" Content="Rimuovi" VerticalAlignment="Top" Command="{Binding RemoveScanRootCommand}" />
                  </Grid>
                  <WrapPanel Margin="0,0,0,8">
                    <Button Style="{StaticResource InlineActionButtonStyle}" Content="Salva set cartelle" Command="{Binding SaveScanRootSetCommand}" />
                    <Button Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,0,6" Content="Carica set cartelle" Command="{Binding LoadScanRootSetCommand}" />
                  </WrapPanel>
                  <Grid Margin="0,0,0,6" Visibility="{Binding HasSelectedScanRootDfsTargets, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Target DFS cartella selezionata" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Grid.Column="1"
                              Height="24"
                              Background="#FFE3F2FD"
                              ItemsSource="{Binding SelectedScanRootDfsTargets}"
                              SelectedItem="{Binding SelectedScanRootDfsTarget, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <TextBlock Text="Output report .ntaudit" Style="{StaticResource SubsectionHeaderText}" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,8,0" Content="Sfoglia..." Command="{Binding BrowseOutputDirectoryCommand}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}" Text="{Binding AuditOutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="Esegui tramite servizio Windows (opzionale)" IsChecked="{Binding UseWindowsServiceMode}" ToolTip="Usa l'host Windows opzionale per eseguire la scansione in background; non aggiunge funzioni di analisi rispetto alla modalita locale." />
                  <TextBlock Text="Mantiene il job attivo anche dopo il logout." Style="{StaticResource MicrocopyText}" Margin="0,0,0,6" TextWrapping="Wrap" ToolTip="Utile per scansioni lunghe o non interattive. La logica di analisi resta la stessa dell'app locale." />
                  <TextBlock Text="Credenziali scansione" Style="{StaticResource SubsectionHeaderText}" />
                  <TextBlock Text="{Binding GlobalCredentialStatusText}" Style="{StaticResource MicrocopyText}" Margin="0,0,0,6" />
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Globali" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,8,0" MinWidth="180" Text="{Binding GlobalCredentialUserName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Utente globale (DOMINIO\utente o utente@dominio)" />
                    <PasswordBox x:Name="GlobalCredentialPasswordBox" Grid.Column="2" Height="28" Width="180" Margin="0,0,8,0" PasswordChanged="GlobalCredentialPasswordBox_OnPasswordChanged" ToolTip="Password credenziali globali" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                      <Button Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,8,0" Content="Salva" Command="{Binding SaveGlobalCredentialCommand}" />
                      <Button Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,0,0" Content="Rimuovi" Command="{Binding ClearGlobalCredentialCommand}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding SelectedScanRootCredentialStatusText}" Style="{StaticResource MicrocopyText}" Margin="0,0,0,4" />
                  <TextBlock Text="{Binding SelectedScanRootEffectiveCredentialSource}" Style="{StaticResource MicrocopyText}" Margin="0,0,0,6"
                             ToolTip="Per percorsi locali o non UNC l'app non applica credenziali salvate: resta l'utente corrente." />
                  <Grid Margin="0,0,0,8" IsEnabled="{Binding HasSelectedScanRoot}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Override root" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,8,0" MinWidth="180" Text="{Binding SelectedScanRootCredentialUserName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Utente dedicato per la root selezionata" />
                    <PasswordBox x:Name="SelectedScanRootCredentialPasswordBox" Grid.Column="2" Height="28" Width="180" Margin="0,0,8,0" PasswordChanged="SelectedScanRootCredentialPasswordBox_OnPasswordChanged" ToolTip="Password override root" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                      <Button Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,8,0" Content="Salva" Command="{Binding SaveScanRootCredentialCommand}" />
                      <Button Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,0,0" Content="Rimuovi" Command="{Binding ClearScanRootCredentialCommand}" />
                    </StackPanel>
                  </Grid>
                  <Expander Header="Opzioni principali" IsExpanded="True">
                    <StackPanel Margin="0,6,0,0">
                      <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Profondita" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Width="60" Height="28" Text="{Binding MaxDepth}" IsEnabled="{Binding IsMaxDepthEnabled}" Margin="0,0,12,0" />
                        <CheckBox Grid.Column="2" Style="{StaticResource OptionCheckBoxStyle}" Content="Analizza tutte le sottocartelle" IsChecked="{Binding ScanAllDepths}" Margin="0" />
                      </Grid>
                      <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="Includi permessi ereditati" IsChecked="{Binding IncludeInherited}" Margin="0" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </GroupBox>

              <GroupBox Header="Opzioni" Style="{StaticResource AppGroupBoxStyle}" Margin="0,10,0,0" IsEnabled="{Binding IsScanConfigEnabled}" Visibility="{Binding IsNotViewerMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                  <TextBlock Text="Identita" Style="{StaticResource SubsectionHeaderText}" />
                  <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="Risolvi identita" IsChecked="{Binding ResolveIdentities}" />
                  <TextBlock Text="Piu accuratezza, con possibile costo prestazionale." Style="{StaticResource MicrocopyText}" ToolTip="Attiva la risoluzione SID, gruppi e utenti tramite resolver disponibili." />
                  <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="Espandi gruppi annidati" IsChecked="{Binding ExpandGroups}" IsEnabled="{Binding IsExpandGroupsEnabled}" />
                  <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="Usa PowerShell per AD" IsChecked="{Binding UsePowerShell}" IsEnabled="{Binding IsIdentityOptionsEnabled}" />
                  <Expander Header="Audit avanzato" IsExpanded="True" Margin="0,8,0,0" ToolTip="Opzioni amministrative aggiuntive per Effective Access, Share, file, Owner/SACL e baseline.">
                    <StackPanel Margin="0,6,0,0">
                      <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="Abilita audit avanzato" IsChecked="{Binding EnableAdvancedAudit}" />
                      <StackPanel Margin="0,4,0,0" IsEnabled="{Binding IsAdvancedAuditEnabled}">
                      <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="Calcola Effective Access" IsChecked="{Binding ComputeEffectiveAccess}" />
                      <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="Leggi permessi Share (SMB)" IsChecked="{Binding IncludeSharePermissions}" />
                      <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="Scansiona file" IsChecked="{Binding IncludeFiles}" />
                      <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="Leggi Owner e SACL" IsChecked="{Binding ReadOwnerAndSacl}" />
                      <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Margin="0" Content="Confronta con baseline/policy attese" IsChecked="{Binding CompareBaseline}" />
                      </StackPanel>
                    </StackPanel>
                  </Expander>
                  <TextBlock Text="Esclusioni" Style="{StaticResource SubsectionHeaderText}" />
                  <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="Escludi utenti di servizio" IsChecked="{Binding ExcludeServiceAccounts}" IsEnabled="{Binding IsIdentityOptionsEnabled}" />
                  <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Margin="0" Content="Escludi utenti admin" IsChecked="{Binding ExcludeAdminAccounts}" IsEnabled="{Binding IsIdentityOptionsEnabled}" />
                </StackPanel>
              </GroupBox>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
</UserControl>
