<UserControl x:Class="NtfsAudit.App.Views.ScanSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource PanelBorderStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="{DynamicResource Scan.Status}" Style="{StaticResource AppGroupBoxStyle}" Margin="0">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <Border Width="14" Height="14" Background="{Binding StatusBrush}" CornerRadius="2" Margin="0,0,6,0" />
                  <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border Background="{Binding CurrentPathBackground}" Padding="6" CornerRadius="4" Margin="0,0,0,8">
                  <TextBlock Text="{Binding CurrentPathText}" TextTrimming="CharacterEllipsis" />
                </Border>
                <WrapPanel Margin="0,0,0,6">
                  <Border Style="{StaticResource MetricPillBorderStyle}" Background="#FFE8F5E9">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{DynamicResource Scan.FoldersProcessed}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ProcessedCount}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource MetricPillBorderStyle}" Background="#FFE3F2FD">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{DynamicResource Scan.FilesProcessed}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ProcessedFilesCount}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource MetricPillBorderStyle}" Background="#FFFFEBEE">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{DynamicResource Scan.Errors}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ErrorCount}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource MetricPillBorderStyle}" Background="#FFF5F5F5">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{DynamicResource Scan.Elapsed}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ElapsedText}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </WrapPanel>
              </StackPanel>
            </GroupBox>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
              <StackPanel>
              <GroupBox Header="{DynamicResource Scan.Section}" Style="{StaticResource AppGroupBoxStyle}" Margin="0" IsEnabled="{Binding IsScanConfigEnabled}" Visibility="{Binding IsNotViewerMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Scan.PathsAndOutput}" Style="{StaticResource SubsectionHeaderText}" />
                  <TextBlock Text="{DynamicResource Scan.FoldersToScan}" Style="{StaticResource SubsectionHeaderText}" />
                  <TextBlock Text="{DynamicResource Scan.FoldersHint}" Style="{StaticResource MicrocopyText}" ToolTip="Puoi fermare la scansione o il job con pulizia residui, modificare questo elenco e riavviare con nuove cartelle." />
                  <TextBlock Text="{DynamicResource Scan.StartHint}"
                             Style="{StaticResource MicrocopyText}"
                             Foreground="#FF856404"
                             TextWrapping="Wrap"
                             Visibility="{Binding ShouldShowStartHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,8,0" Content="{DynamicResource Common.Browse}" AutomationProperties.Name="Sfoglia cartella da scansionare" Command="{Binding BrowseCommand}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}" AutomationProperties.Name="Percorso cartella da scansionare" ToolTip="Percorso locale, UNC, DFS o NFS-classificato da analizzare." Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Style="{StaticResource InlineActionButtonStyle}" Margin="8,0,0,0" Content="{DynamicResource Common.Add}" AutomationProperties.Name="Aggiungi cartella da scansionare" Command="{Binding AddScanRootCommand}" />
                  </Grid>
                  <Grid Margin="0,0,0,6" Visibility="{Binding HasDfsTargets, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Scan.InputDfsTarget}" VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="{DynamicResource Scan.InputDfsTarget.ToolTip}" />
                    <ComboBox Grid.Column="1"
                              Height="28"
                              Background="#FFE3F2FD"
                              ItemsSource="{Binding DfsTargets}"
                              SelectedItem="{Binding SelectedDfsTarget, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" Height="90" ItemsSource="{Binding ScanRoots}" SelectedItem="{Binding SelectedScanRoot}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="4" Margin="0,1" CornerRadius="3" Background="{Binding Converter={StaticResource ScanRootPathKindBrushConverter}}">
                            <DockPanel>
                              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Border Background="#FF37474F" CornerRadius="8" Padding="6,1" Margin="4,0,0,0">
                                  <TextBlock Text="{Binding Converter={StaticResource ScanRootPathKindLabelConverter}}" Foreground="White" FontSize="10" />
                                </Border>
                                <Border Background="#FF6A1B9A" CornerRadius="8" Padding="6,1" Margin="4,0,0,0"
                                        Visibility="{Binding Converter={StaticResource DfsMultiServerVisibilityConverter}}">
                                  <TextBlock Text="DFS multi-server" Foreground="White" FontSize="10" />
                                </Border>
                              </StackPanel>
                              <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,6,0" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Column="1" Style="{StaticResource InlineActionButtonStyle}" Margin="8,0,0,0" Content="{DynamicResource Common.Remove}" AutomationProperties.Name="Rimuovi cartella selezionata" VerticalAlignment="Top" Command="{Binding RemoveScanRootCommand}" />
                  </Grid>
                  <WrapPanel Margin="0,0,0,8">
                    <Button Style="{StaticResource InlineActionButtonStyle}" Content="{DynamicResource Scan.SaveFolderSet}" AutomationProperties.Name="Salva set cartelle" Command="{Binding SaveScanRootSetCommand}" />
                    <Button Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,0,6" Content="{DynamicResource Scan.LoadFolderSet}" AutomationProperties.Name="Carica set cartelle" Command="{Binding LoadScanRootSetCommand}" />
                  </WrapPanel>
                  <Grid Margin="0,0,0,6" Visibility="{Binding HasSelectedScanRootDfsTargets, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Scan.SelectedFolderDfsTarget}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Grid.Column="1"
                              Height="24"
                              Background="#FFE3F2FD"
                              ItemsSource="{Binding SelectedScanRootDfsTargets}"
                              SelectedItem="{Binding SelectedScanRootDfsTarget, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <TextBlock Text="{DynamicResource Scan.OutputReport}" Style="{StaticResource SubsectionHeaderText}" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,8,0" Content="{DynamicResource Common.Browse}" AutomationProperties.Name="Sfoglia cartella output .ntaudit" Command="{Binding BrowseOutputDirectoryCommand}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}" AutomationProperties.Name="Cartella output report .ntaudit" ToolTip="Cartella in cui salvare automaticamente i report .ntaudit generati dalla scansione." Text="{Binding AuditOutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <TextBlock Text="{DynamicResource Scan.Credentials}" Style="{StaticResource SubsectionHeaderText}" />
                  <TextBlock Text="{Binding GlobalCredentialStatusText}" Style="{StaticResource MicrocopyText}" Margin="0,0,0,6" />
                  <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Scan.GlobalUser}" Style="{StaticResource MicrocopyText}" Margin="0,0,0,2" />
                    <TextBox Style="{StaticResource FieldTextBoxStyle}" MinWidth="0" AutomationProperties.Name="Utente globale credenziali scansione" Text="{Binding GlobalCredentialUserName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Utente globale (DOMINIO\utente o utente@dominio)" />
                    <TextBlock Text="{DynamicResource Scan.GlobalPassword}" Style="{StaticResource MicrocopyText}" Margin="0,4,0,2" />
                    <PasswordBox x:Name="GlobalCredentialPasswordBox" Height="28" AutomationProperties.Name="{DynamicResource Scan.GlobalPassword.AutomationName}" PasswordChanged="GlobalCredentialPasswordBox_OnPasswordChanged" ToolTip="{DynamicResource Scan.GlobalPassword.ToolTip}" />
                    <WrapPanel Margin="0,6,0,0">
                      <Button Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,8,0" Content="{DynamicResource Common.Save}" AutomationProperties.Name="Salva credenziali globali" Command="{Binding SaveGlobalCredentialCommand}" />
                      <Button Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,0,0" Content="{DynamicResource Common.Remove}" AutomationProperties.Name="Rimuovi credenziali globali" Command="{Binding ClearGlobalCredentialCommand}" />
                    </WrapPanel>
                  </StackPanel>
                  <TextBlock Text="{Binding SelectedScanRootEffectiveCredentialSource}" Style="{StaticResource MicrocopyText}" Margin="0,0,0,6"
                             ToolTip="{DynamicResource Credential.LocalPathCurrentUser.ToolTip}" />
                  <TextBlock Text="{DynamicResource Scan.Compatibility}" Style="{StaticResource SubsectionHeaderText}" />
                  <TextBlock Text="{DynamicResource Scan.CompatibleOptionsHint}" Style="{StaticResource MicrocopyText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                  <WrapPanel Margin="0,0,0,8">
                    <Button Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,8,0" Content="{DynamicResource Scan.ApplyCompatibleOptions}" AutomationProperties.Name="{DynamicResource Scan.ApplyCompatibleOptions}" Command="{Binding ApplyCompatibleScanOptionsCommand}" />
                  </WrapPanel>
                  <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{DynamicResource Scan.ServiceMode}" IsChecked="{Binding UseWindowsServiceMode}" ToolTip="Usa l'host Windows opzionale per eseguire la scansione in background; non aggiunge funzioni di analisi rispetto alla modalita locale." />
                  <TextBlock Text="{DynamicResource Scan.ServiceModeHint}" Style="{StaticResource MicrocopyText}" Margin="0,0,0,6" TextWrapping="Wrap" ToolTip="Utile per scansioni lunghe o non interattive. La logica di analisi resta la stessa dell'app locale." />
                  <TextBlock Text="{DynamicResource Scan.DepthOptions}" Style="{StaticResource SubsectionHeaderText}" />
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Scan.Depth}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Width="60" Height="28" AutomationProperties.Name="Profondita massima scansione" ToolTip="Numero massimo di livelli da analizzare quando l'analisi di tutte le sottocartelle è disattivata." Text="{Binding MaxDepth}" IsEnabled="{Binding IsMaxDepthEnabled}" Margin="0,0,12,0" />
                    <CheckBox Grid.Column="2" Style="{StaticResource OptionCheckBoxStyle}" Content="{DynamicResource Scan.AllSubfolders}" IsChecked="{Binding ScanAllDepths}" Margin="0" />
                  </Grid>
                  <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{DynamicResource Scan.IncludeInherited}" IsChecked="{Binding IncludeInherited}" Margin="0" />
                </StackPanel>
              </GroupBox>

              <GroupBox Header="{DynamicResource Scan.Options}" Style="{StaticResource AppGroupBoxStyle}" Margin="0,10,0,0" IsEnabled="{Binding IsScanConfigEnabled}" Visibility="{Binding IsNotViewerMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Scan.Identity}" Style="{StaticResource SubsectionHeaderText}" />
                  <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{DynamicResource Scan.ResolveIdentities}" IsChecked="{Binding ResolveIdentities}" />
                  <TextBlock Text="{DynamicResource Scan.IdentityHint}" Style="{StaticResource MicrocopyText}" ToolTip="Attiva la risoluzione SID, gruppi e utenti tramite resolver disponibili." />
                  <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{DynamicResource Scan.ExpandGroups}" IsChecked="{Binding ExpandGroups}" IsEnabled="{Binding IsExpandGroupsEnabled}" />
                  <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{DynamicResource Scan.UsePowerShell}" IsChecked="{Binding UsePowerShell}" IsEnabled="{Binding IsIdentityOptionsEnabled}" />
                  <TextBlock Text="{DynamicResource Scan.AdvancedAudit}" Style="{StaticResource SubsectionHeaderText}" ToolTip="Opzioni amministrative aggiuntive per Effective Access, Share, file, Owner/SACL e baseline." />
                  <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{DynamicResource Scan.EnableAdvancedAudit}" IsChecked="{Binding EnableAdvancedAudit}" />
                  <StackPanel Margin="0,4,0,0" IsEnabled="{Binding IsAdvancedAuditEnabled}">
                    <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{DynamicResource Scan.ComputeEffectiveAccess}" IsChecked="{Binding ComputeEffectiveAccess}" />
                    <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{DynamicResource Scan.IncludeSharePermissions}" IsChecked="{Binding IncludeSharePermissions}" />
                    <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{DynamicResource Scan.IncludeFiles}" IsChecked="{Binding IncludeFiles}" />
                    <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{DynamicResource Scan.ReadOwnerAndSacl}" IsChecked="{Binding ReadOwnerAndSacl}" />
                    <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Margin="0" Content="{DynamicResource Scan.CompareBaseline}" IsChecked="{Binding CompareBaseline}" />
                  </StackPanel>
                  <TextBlock Text="{DynamicResource Scan.Exclusions}" Style="{StaticResource SubsectionHeaderText}" />
                  <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Content="{DynamicResource Scan.ExcludeServiceAccounts}" IsChecked="{Binding ExcludeServiceAccounts}" IsEnabled="{Binding IsIdentityOptionsEnabled}" />
                  <CheckBox Style="{StaticResource OptionCheckBoxStyle}" Margin="0" Content="{DynamicResource Scan.ExcludeAdminAccounts}" IsChecked="{Binding ExcludeAdminAccounts}" IsEnabled="{Binding IsIdentityOptionsEnabled}" />
                </StackPanel>
              </GroupBox>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
</UserControl>
