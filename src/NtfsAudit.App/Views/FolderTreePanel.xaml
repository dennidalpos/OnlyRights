<UserControl x:Class="NtfsAudit.App.Views.FolderTreePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource PanelBorderStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="{DynamicResource Tree.Title}" Style="{StaticResource SectionHeaderText}" />

      <Grid Grid.Row="1" Margin="0,0,0,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
          <Button Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,8,0" Content="{DynamicResource Tree.ExpandAll}" IsEnabled="{Binding HasScanResult}" Click="ExpandTree_Click" />
          <Button Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,0,0" Content="{DynamicResource Tree.CollapseAll}" IsEnabled="{Binding HasScanResult}" Click="CollapseTree_Click" />
        </WrapPanel>

        <Expander Grid.Row="1"
                  Header="{DynamicResource Tree.LegendFilters}"
                  Style="{StaticResource TreeSectionExpanderStyle}"
                  IsExpanded="False"
                  IsEnabled="{Binding HasScanResult}">
          <Border Style="{StaticResource SupportPanelBorderStyle}"
                  Margin="0,4,0,0">
            <StackPanel>
              <WrapPanel Margin="0,0,0,6">
                <CheckBox Margin="0,0,12,6" IsChecked="{Binding TreeFilterExplicitOnly}" ToolTip="{DynamicResource Tree.ExplicitNtfs.ToolTip}">
                  <Border Background="#FF00897B" Style="{StaticResource FilterChipBorderStyle}">
                    <TextBlock Text="{DynamicResource Tree.ExplicitNtfs.Badge}" Style="{StaticResource SemanticChipTextStyle}" />
                  </Border>
                </CheckBox>
                <CheckBox Margin="0,0,12,6" IsChecked="{Binding TreeFilterInheritanceDisabledOnly}" ToolTip="{DynamicResource Tree.Protected.ToolTip}">
                  <Border Background="#FFC62828" Style="{StaticResource FilterChipBorderStyle}">
                    <TextBlock Text="{DynamicResource Tree.Protected.Badge}" Style="{StaticResource SemanticChipTextStyle}" />
                  </Border>
                </CheckBox>
                <CheckBox Margin="0,0,12,6" IsChecked="{Binding TreeFilterDiffOnly}" ToolTip="{DynamicResource Tree.DiffParent.ToolTip}">
                  <Border Background="#FF455A64" Style="{StaticResource FilterChipBorderStyle}">
                    <TextBlock Text="{DynamicResource Tree.DiffParent.Badge}" Style="{StaticResource SemanticChipTextStyle}" />
                  </Border>
                </CheckBox>
                <CheckBox Margin="0,0,12,6" IsChecked="{Binding TreeFilterExplicitDenyOnly}" ToolTip="{DynamicResource Tree.ExplicitDeny.ToolTip}">
                  <Border Background="#FFAD1457" Style="{StaticResource FilterChipBorderStyle}">
                    <TextBlock Text="{DynamicResource Tree.ExplicitDeny.Badge}" Style="{StaticResource SemanticChipTextStyle}" />
                  </Border>
                </CheckBox>
                <CheckBox Margin="0,0,12,6" IsChecked="{Binding TreeFilterBaselineMismatchOnly}" ToolTip="{DynamicResource Tree.BaselineMismatch.ToolTip}">
                  <Border Background="#FF455A64" Style="{StaticResource FilterChipBorderStyle}">
                    <TextBlock Text="{DynamicResource Tree.BaselineMismatch.Badge}" Style="{StaticResource SemanticChipTextStyle}" />
                  </Border>
                </CheckBox>
                <CheckBox Margin="0,0,12,6" IsChecked="{Binding TreeFilterFilesOnly}" ToolTip="{DynamicResource Tree.WithFiles.ToolTip}">
                  <Border Background="#FF616161" Style="{StaticResource FilterChipBorderStyle}">
                    <TextBlock Text="{DynamicResource Tree.WithFiles.Badge}" Style="{StaticResource SemanticChipTextStyle}" />
                  </Border>
                </CheckBox>
                <CheckBox Margin="0,0,12,6" IsChecked="{Binding TreeFilterFoldersOnly}" ToolTip="{DynamicResource Tree.FoldersOnly.ToolTip}">
                  <Border Background="#FF455A64" Style="{StaticResource FilterChipBorderStyle}">
                    <TextBlock Text="{DynamicResource Tree.FoldersOnly.Badge}" Style="{StaticResource SemanticChipTextStyle}" />
                  </Border>
                </CheckBox>
              </WrapPanel>
              <Button Style="{StaticResource InlineActionButtonStyle}" Content="{DynamicResource Tree.ResetFilters}" Width="138" Margin="0" Command="{Binding ResetTreeFiltersCommand}" />
            </StackPanel>
          </Border>
        </Expander>
      </Grid>

      <Border Grid.Row="2"
              Style="{StaticResource EmptyStateBorderStyle}"
              Visibility="{Binding HasNoScanResult, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock Text="{DynamicResource Tree.Empty}"
                   Style="{StaticResource EmptyStateText}" />
      </Border>

      <TreeView x:Name="FolderTreeView"
                Grid.Row="2"
                ItemsSource="{Binding FolderTree}"
                AutomationProperties.Name="{DynamicResource Tree.AutomationName}"
                Visibility="{Binding HasScanResult, Converter={StaticResource BooleanToVisibilityConverter}}"
                SelectedItemChanged="TreeView_OnSelectedItemChanged"
                VirtualizingStackPanel.IsVirtualizing="True"
                VirtualizingStackPanel.VirtualizationMode="Recycling">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="2" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#FFDCEBFA" />
                <Setter Property="Foreground" Value="#FF0B457D" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
              <TextBlock Text="{DynamicResource Tree.RootTypeLabel}" Margin="0,0,6,0" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
              <Border Background="#FFAD1457" ToolTip="{DynamicResource Tree.DenyBadge.ToolTip}">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource TreeInlineChipBorderStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasDenyExplicit}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{DynamicResource Tree.ExplicitDeny.Badge}" Style="{StaticResource SemanticChipTextStyle}" />
              </Border>
              <Border Background="#FFC62828" ToolTip="{DynamicResource Tree.ProtectedBadge.ToolTip}">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource TreeInlineChipBorderStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsProtected}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{DynamicResource Tree.Protected.Badge}" Style="{StaticResource SemanticChipTextStyle}" />
              </Border>
              <Border Background="#FF455A64" ToolTip="{DynamicResource Tree.DiffBadge.ToolTip}">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource TreeInlineChipBorderStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasDiff}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{DynamicResource Tree.DiffParent.Badge}" Style="{StaticResource SemanticChipTextStyle}" />
              </Border>
              <Border Background="#FF455A64" ToolTip="{DynamicResource Tree.BaselineBadge.ToolTip}">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource TreeInlineChipBorderStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasBaselineMismatch}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{DynamicResource Tree.BaselineMismatch.Badge}" Style="{StaticResource SemanticChipTextStyle}" />
              </Border>
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Grid>
  </Border>
</UserControl>
