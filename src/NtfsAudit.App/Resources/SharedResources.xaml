<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:services="clr-namespace:NtfsAudit.App.Services">
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  <services:ScanRootPathKindLabelConverter x:Key="ScanRootPathKindLabelConverter" />
  <services:ScanRootPathKindBrushConverter x:Key="ScanRootPathKindBrushConverter" />
  <services:DfsMultiServerVisibilityConverter x:Key="DfsMultiServerVisibilityConverter" />
  <services:HeightPercentageConverter x:Key="HeightPercentageConverter" />

  <Color x:Key="AppBackgroundColor">#FFF8FAFC</Color>
  <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
  <Color x:Key="SurfaceMutedColor">#FFF1F5F9</Color>
  <Color x:Key="SurfaceAccentColor">#FFE2E8F0</Color>
  <Color x:Key="BorderSoftColor">#FFE2E8F0</Color>
  <Color x:Key="BorderStrongColor">#FFCBD5E1</Color>
  <Color x:Key="TextPrimaryColor">#FF0F172A</Color>
  <Color x:Key="TextSecondaryColor">#FF475569</Color>
  <Color x:Key="TextMutedColor">#FF64748B</Color>
  <Color x:Key="AccentColor">#FF4F46E5</Color>
  <Color x:Key="AccentHoverColor">#FF4338CA</Color>
  <Color x:Key="AccentBorderColor">#FF3730A3</Color>
  <Color x:Key="SuccessColor">#FF10B981</Color>
  <Color x:Key="WarningColor">#FFF59E0B</Color>
  <Color x:Key="DangerColor">#FFEF4444</Color>
  <Color x:Key="NeutralBadgeColor">#FF64748B</Color>
  <Color x:Key="WarningSurfaceColor">#FEF3C7</Color>
  <Color x:Key="WarningBorderColor">#FCD34D</Color>
  <Color x:Key="WarningTextColor">#92400E</Color>

  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
  <SolidColorBrush x:Key="SurfaceAccentBrush" Color="{StaticResource SurfaceAccentColor}" />
  <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentBorderColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="NeutralBadgeBrush" Color="{StaticResource NeutralBadgeColor}" />
  <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}" />
  <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorderColor}" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />
  <SolidColorBrush x:Key="PermissionReadBrush" Color="#FF2F80ED" />
  <SolidColorBrush x:Key="PermissionWriteBrush" Color="#FF27AE60" />
  <SolidColorBrush x:Key="PermissionModifyBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="PermissionFullBrush" Color="#FF9B51E0" />
  <SolidColorBrush x:Key="PermissionDenyBrush" Color="#FFEB5757" />
  <SolidColorBrush x:Key="PermissionProtectedBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="PermissionDifferenceBrush" Color="#FF455A64" />
  <SolidColorBrush x:Key="PermissionFileEntriesBrush" Color="#FF616161" />
  <SolidColorBrush x:Key="PermissionExplicitNtfsBrush" Color="#FF00897B" />
  <SolidColorBrush x:Key="PermissionExplicitDenyBrush" Color="#FFAD1457" />

  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="BadgeCornerRadius">12</CornerRadius>
  <Thickness x:Key="PanelPadding">16</Thickness>
  <Thickness x:Key="CardPadding">12,10</Thickness>
  <Thickness x:Key="SectionSpacing">0,0,0,14</Thickness>
  <Thickness x:Key="ControlRowSpacing">0,0,0,12</Thickness>
  <Thickness x:Key="InlineElementSpacing">0,0,10,0</Thickness>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Microsoft YaHei UI, Microsoft JhengHei UI, Yu Gothic UI" />
  </Style>

  <Style TargetType="FrameworkElement">
    <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
    <Setter Property="ToolTipService.ShowDuration" Value="8000" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Placement" Value="Mouse" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Background" Value="#FF1F2933" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="#FF334155" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="TextElement.Foreground" Value="White" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <Border TextElement.Foreground="{TemplateBinding Foreground}">
              <Border.Resources>
                <DataTemplate DataType="{x:Type sys:String}">
                  <TextBlock Text="{Binding}"
                             Foreground="White"
                             TextWrapping="Wrap" />
                </DataTemplate>
                <Style TargetType="Control">
                  <Setter Property="Foreground" Value="White" />
                </Style>
                <Style TargetType="Label">
                  <Setter Property="Foreground" Value="White" />
                </Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="White" />
                </Style>
                <Style TargetType="AccessText">
                  <Setter Property="Foreground" Value="White" />
                </Style>
                <Style TargetType="Run">
                  <Setter Property="Foreground" Value="White" />
                </Style>
              </Border.Resources>
              <ContentPresenter x:Name="ContentSite"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <ControlTemplate x:Key="FilledActionButtonTemplate" TargetType="Button">
    <Border x:Name="Chrome"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource ControlCornerRadius}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Margin="{TemplateBinding Padding}" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHoverBrush}" />
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Chrome" Property="Opacity" Value="1" />
        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="OutlinedActionButtonTemplate" TargetType="Button">
    <Border x:Name="Chrome"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource ControlCornerRadius}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Margin="{TemplateBinding Padding}" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceAccentBrush}" />
        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Chrome" Property="Opacity" Value="1" />
        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="ActionButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinWidth" Value="164" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template" Value="{StaticResource FilledActionButtonTemplate}" />
  </Style>

  <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="Template" Value="{StaticResource OutlinedActionButtonTemplate}" />
  </Style>

  <Style x:Key="InlineActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinWidth" Value="108" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinWidth" Value="180" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinWidth" Value="140" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="OptionCheckBoxStyle" TargetType="CheckBox">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="FieldRowGridStyle" TargetType="Grid">
    <Setter Property="Margin" Value="{StaticResource ControlRowSpacing}" />
  </Style>

  <Style x:Key="InlineActionsPanelStyle" TargetType="WrapPanel">
    <Setter Property="Margin" Value="{StaticResource ControlRowSpacing}" />
  </Style>

  <Style x:Key="SectionStackPanelStyle" TargetType="StackPanel">
    <Setter Property="Margin" Value="{StaticResource SectionSpacing}" />
  </Style>

  <Style x:Key="AppGroupBoxStyle" TargetType="GroupBox">
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="0,0,0,14" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <StackPanel SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header"
                              Margin="2,0,0,8"
                              TextElement.FontSize="15"
                              TextElement.FontWeight="SemiBold"
                              TextElement.Foreground="{StaticResource TextPrimaryBrush}" />
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PanelBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="EmptyStateBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="InfoCardBorderStyle" TargetType="Border">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    <Setter Property="Margin" Value="0,0,10,10" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
  </Style>

  <Style x:Key="NeutralInfoCardBorderStyle" TargetType="Border" BasedOn="{StaticResource InfoCardBorderStyle}">
    <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
  </Style>

  <Style x:Key="CompactInfoCardBorderStyle" TargetType="Border" BasedOn="{StaticResource InfoCardBorderStyle}">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
  </Style>

  <Style x:Key="CompactNeutralInfoCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CompactInfoCardBorderStyle}">
    <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
  </Style>

  <Style x:Key="SupportPanelBorderStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
    <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style x:Key="MetricPillBorderStyle" TargetType="Border">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>

  <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource BadgeCornerRadius}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="WarningStatusBadgeBorderStyle" TargetType="Border" BasedOn="{StaticResource StatusBadgeBorderStyle}">
    <Setter Property="Background" Value="{StaticResource WarningSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
  </Style>

  <Style x:Key="InfoLabelText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="InfoValueText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="CompactInfoLabelText" TargetType="TextBlock" BasedOn="{StaticResource InfoLabelText}">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="CompactInfoValueText" TargetType="TextBlock" BasedOn="{StaticResource InfoValueText}">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="ExpanderHeaderText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="ExpanderHeaderHintText" TargetType="TextBlock" BasedOn="{StaticResource ExpanderHeaderText}">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <Style x:Key="SectionHeaderText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style x:Key="SubsectionHeaderText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="MicrocopyText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="FieldLabelText" TargetType="TextBlock" BasedOn="{StaticResource MicrocopyText}">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="ToolbarLabelText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource MicrocopyText}">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style x:Key="InteractionHintText" TargetType="TextBlock" BasedOn="{StaticResource MicrocopyText}">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style TargetType="TreeView">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style TargetType="Expander">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="ResultsSectionExpanderStyle" TargetType="Expander">
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton x:Name="HeaderSite"
                          Focusable="False"
                          Background="{StaticResource SurfaceMutedBrush}"
                          BorderBrush="{StaticResource BorderSoftBrush}"
                          BorderThickness="1"
                          Padding="10,7"
                          HorizontalContentAlignment="Stretch"
                          Content="{TemplateBinding Header}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Path x:Name="Chevron"
                            Grid.Column="0"
                            Width="8"
                            Height="8"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Stroke="{StaticResource TextSecondaryBrush}"
                            StrokeThickness="1.75"
                            Data="M 1 1 L 4 4 L 7 1" />
                      <ContentPresenter Grid.Column="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        ContentSource="Content" />
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceAccentBrush}" />
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Chevron" Property="RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="180" CenterX="4" CenterY="4" />
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Border x:Name="ExpandSite"
                    Margin="0,4,0,0"
                    Visibility="Collapsed">
              <ContentPresenter />
            </Border>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TreeSectionExpanderStyle"
         TargetType="Expander"
         BasedOn="{StaticResource ResultsSectionExpanderStyle}" />

  <Style TargetType="TabControl">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid>
            <Border x:Name="Chrome"
                    Background="{StaticResource SurfaceAccentBrush}"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,0,1,1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 ContentSource="Header" />
            </Border>
            <Border x:Name="HighlightBar"
                    Height="3"
                    Background="{StaticResource AccentBrush}"
                    VerticalAlignment="Top"
                    Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceBrush}" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="0,0,1,0" />
              <Setter TargetName="HighlightBar" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ResultsTabItemStyle"
         TargetType="TabItem"
         BasedOn="{StaticResource {x:Type TabItem}}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,8" />
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="#FFE6ECF2" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeaderWidth" Value="0" />
    <Setter Property="ColumnHeaderHeight" Value="34" />
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <Style x:Key="RightsRowStyle" TargetType="DataGridRow">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsDisabled}" Value="True">
        <Setter Property="TextBlock.TextDecorations" Value="Strikethrough" />
        <Setter Property="Foreground" Value="#FF9E9E9E" />
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding DataContext.ColorizeRights, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
          <Condition Binding="{Binding HasRead}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="#FFEAF4FF" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding DataContext.ColorizeRights, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
          <Condition Binding="{Binding HasList}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="#FFEAF4FF" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding DataContext.ColorizeRights, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
          <Condition Binding="{Binding HasReadAndExecute}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="#FFEAF4FF" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding DataContext.ColorizeRights, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
          <Condition Binding="{Binding HasWrite}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="#FFEBF8EF" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding DataContext.ColorizeRights, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
          <Condition Binding="{Binding HasModify}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="#FFFFF4E8" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding DataContext.ColorizeRights, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
          <Condition Binding="{Binding HasFullControl}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="#FFF6EEFC" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding DataContext.ColorizeRights, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
          <Condition Binding="{Binding AllowDeny}" Value="Deny" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="#FFFFEEF1" />
        <Setter Property="Foreground" Value="#FFB42318" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Rectangle Fill="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MinimalScrollBarThumbStyle" TargetType="Thumb">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="ThumbBorder"
                  Background="#82374151"
                  CornerRadius="4" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="#A03A4758" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="#C03A4758" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
    <Grid Width="10" Background="Transparent" Margin="2,4,2,4">
      <Border Background="#140F172A" CornerRadius="5" />
      <Track x:Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageUpCommand" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource MinimalScrollBarThumbStyle}" Width="6" MinHeight="18" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageDownCommand" />
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
    <Grid Height="10" Background="Transparent" Margin="4,2,4,2">
      <Border Background="#140F172A" CornerRadius="5" />
      <Track x:Name="PART_Track">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageLeftCommand" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource MinimalScrollBarThumbStyle}" Height="6" MinWidth="18" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="ScrollBar.PageRightCommand" />
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="BadgeToolTipBorder" TargetType="Border">
    <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
    <Setter Property="ToolTipService.ShowDuration" Value="8000" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
  </Style>

  <Style x:Key="CompactBadgeBorderStyle" TargetType="Border" BasedOn="{StaticResource BadgeToolTipBorder}">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="InlineCompactBadgeBorderStyle" TargetType="Border" BasedOn="{StaticResource BadgeToolTipBorder}">
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="CompactBadgeText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="SemanticChipBorderStyle" TargetType="Border">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="LegendChipBorderStyle" TargetType="Border" BasedOn="{StaticResource SemanticChipBorderStyle}">
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>

  <Style x:Key="TreeInlineChipBorderStyle" TargetType="Border" BasedOn="{StaticResource SemanticChipBorderStyle}">
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="Margin" Value="6,0,0,0" />
  </Style>

  <Style x:Key="FilterChipBorderStyle" TargetType="Border" BasedOn="{StaticResource SemanticChipBorderStyle}">
    <Setter Property="Margin" Value="0,0,0,0" />
  </Style>

  <Style x:Key="SemanticChipTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <DataTemplate x:Key="PermissionBadgesTemplate">
    <StackPanel Orientation="Horizontal">
      <Border>
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource InlineCompactBadgeBorderStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="{StaticResource PermissionReadBrush}" />
            <Setter Property="ToolTip" Value="{DynamicResource Badge.Read.ToolTip}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HighestRightKey}" Value="Full">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Background" Value="{StaticResource PermissionFullBrush}" />
                <Setter Property="ToolTip" Value="{DynamicResource Badge.Full.ToolTip}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding HighestRightKey}" Value="Modify">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Background" Value="{StaticResource PermissionModifyBrush}" />
                <Setter Property="ToolTip" Value="{DynamicResource Badge.Modify.ToolTip}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding HighestRightKey}" Value="ReadAndExecute">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Background" Value="{StaticResource PermissionReadBrush}" />
                <Setter Property="ToolTip" Value="{DynamicResource Badge.ReadAndExecute.ToolTip}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding HighestRightKey}" Value="Write">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Background" Value="{StaticResource PermissionWriteBrush}" />
                <Setter Property="ToolTip" Value="{DynamicResource Badge.Write.ToolTip}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding HighestRightKey}" Value="List">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Background" Value="{StaticResource PermissionReadBrush}" />
                <Setter Property="ToolTip" Value="{DynamicResource Badge.List.ToolTip}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding HighestRightKey}" Value="Read">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Background" Value="{StaticResource PermissionReadBrush}" />
                <Setter Property="ToolTip" Value="{DynamicResource Badge.Read.ToolTip}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock>
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource CompactBadgeText}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HighestRightKey}" Value="Full">
                  <Setter Property="Text" Value="{DynamicResource Badge.Short.Full}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HighestRightKey}" Value="Modify">
                  <Setter Property="Text" Value="{DynamicResource Badge.Short.Modify}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HighestRightKey}" Value="ReadAndExecute">
                  <Setter Property="Text" Value="{DynamicResource Badge.Short.ReadAndExecute}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HighestRightKey}" Value="Write">
                  <Setter Property="Text" Value="{DynamicResource Badge.Short.Write}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HighestRightKey}" Value="List">
                  <Setter Property="Text" Value="{DynamicResource Badge.Short.List}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HighestRightKey}" Value="Read">
                  <Setter Property="Text" Value="{DynamicResource Badge.Short.Read}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Border>
      <Border Background="{StaticResource AccentBrush}" Visibility="{Binding IsInherited, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{DynamicResource Badge.Inherited.ToolTip}" Style="{StaticResource InlineCompactBadgeBorderStyle}">
        <TextBlock Text="{DynamicResource Badge.Short.Inherited}" Style="{StaticResource CompactBadgeText}" />
      </Border>
      <Border Background="{StaticResource PermissionProtectedBrush}" Visibility="{Binding IsInheritanceDisabled, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{DynamicResource Badge.Protected.ToolTip}" Style="{StaticResource InlineCompactBadgeBorderStyle}">
        <TextBlock Text="{DynamicResource Badge.Short.Protected}" Style="{StaticResource CompactBadgeText}" />
      </Border>
      <Border Background="{StaticResource PermissionDenyBrush}" Visibility="{Binding IsExplicitDeny, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{DynamicResource Badge.ExplicitDeny.ToolTip}" Style="{StaticResource InlineCompactBadgeBorderStyle}">
        <TextBlock Text="{DynamicResource Badge.Short.ExplicitDeny}" Style="{StaticResource CompactBadgeText}" />
      </Border>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
