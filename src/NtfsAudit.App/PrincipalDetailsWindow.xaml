<Window x:Class="NtfsAudit.App.PrincipalDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Principal.Details}" Height="420" Width="640" WindowStartupLocation="CenterOwner">
  <Grid Margin="12">
    <Border Style="{StaticResource PanelBorderStyle}" Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Style="{StaticResource SectionHeaderText}" ToolTip="{DynamicResource Principal.Header.ToolTip}" Margin="0" />
        <Grid Grid.Row="1" Margin="0,10,0,0">
          <TextBlock x:Name="EmptyText" Text="{DynamicResource Principal.Empty}" Style="{StaticResource EmptyStateText}" Visibility="Collapsed" />
          <DataGrid x:Name="EntriesGrid"
                    ToolTip="{DynamicResource Principal.Grid.ToolTip}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    EnableRowVirtualization="True"
                    EnableColumnVirtualization="True"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ColumnWidth="SizeToHeader"
                    MinColumnWidth="80">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource Grid.Name}" Binding="{Binding Name}" Width="200" />
              <DataGridTextColumn Header="{DynamicResource Grid.Sid}" Binding="{Binding Sid}" Width="240" />
              <DataGridTextColumn Header="{DynamicResource Grid.Type}" Binding="{Binding Type}" Width="120" />
              <DataGridCheckBoxColumn Header="{DynamicResource Grid.Disabled}" Binding="{Binding IsDisabled, Mode=OneWay}" Width="120" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
