<Window x:Class="NtfsAudit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NtfsAudit.App.Views"
        Title="{DynamicResource App.Title}"
        Icon="pack://application:,,,/NtfsAudit.App;component/Assets/OnlyRights.ico"
        Width="1180"
        Height="720"
        MinWidth="920"
        MinHeight="560"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown"
        Closing="MainWindow_OnClosing">
  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid x:Name="ContentGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsEnabled="{Binding IsNotBusy}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Style="{StaticResource PanelBorderStyle}"
              Margin="16,16,16,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
              <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" ToolTip="{DynamicResource Main.StartAnalysis.ToolTip}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Main.StartAnalysis}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding NewScanCommand}" IsEnabled="{Binding CanNewScan}" ToolTip="{DynamicResource Main.NewScan.ToolTip}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Main.NewScan}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding ImportAnalysisCommand}" IsEnabled="{Binding CanImportAnalysis}" ToolTip="{DynamicResource Main.ImportAnalysis.ToolTip}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B5;" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Main.ImportAnalysis}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}" ToolTip="{DynamicResource Main.ExportExcel.ToolTip}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE15E;" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Main.ExportExcel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>

            <Button Grid.Column="1"
                    x:Name="SettingsToggleButton"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    Margin="12,0,0,0"
                    Command="{Binding ToggleSettingsCommand}"
                    Visibility="{Binding IsNotViewerMode, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Main.Settings}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Grid.Row="1"
                  Margin="0,16,0,12"
                  Style="{StaticResource SupportPanelBorderStyle}"
                  Visibility="{Binding IsNotViewerMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="{DynamicResource Scan.FoldersToScan}" Style="{StaticResource SubsectionHeaderText}" />
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.6*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource FieldTextBoxStyle}"
                             AutomationProperties.Name="{DynamicResource Scan.RootPath.AutomationName}"
                             ToolTip="{DynamicResource Scan.RootPath.ToolTip}"
                             Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource InlineActionButtonStyle}"
                            Margin="10,0,0,0"
                            Content="{DynamicResource Common.Browse}"
                            AutomationProperties.Name="{DynamicResource Scan.RootBrowse.AutomationName}"
                            Command="{Binding BrowseCommand}" />
                    <Button Grid.Column="2"
                            Style="{StaticResource InlineActionButtonStyle}"
                            Margin="10,0,0,0"
                            Content="{DynamicResource Common.Add}"
                            AutomationProperties.Name="{DynamicResource Scan.RootAdd.AutomationName}"
                            Command="{Binding AddScanRootCommand}" />
                  </Grid>
                  <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Scan.FoldersHint}"
                               Style="{StaticResource MicrocopyText}"
                               ToolTip="{DynamicResource Scan.FoldersHint.ToolTip}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource Scan.StartHint}"
                               Style="{StaticResource MicrocopyText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShouldShowStartHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </StackPanel>
                  <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" Height="88" ItemsSource="{Binding ScanRoots}" SelectedItem="{Binding SelectedScanRoot}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="6" Margin="0,1" CornerRadius="4" Background="{Binding Converter={StaticResource ScanRootPathKindBrushConverter}}">
                            <DockPanel LastChildFill="True">
                              <Border Background="#FF334155" CornerRadius="10" Padding="7,1" Margin="8,0,0,0" DockPanel.Dock="Right">
                                <TextBlock Text="{Binding Converter={StaticResource ScanRootPathKindLabelConverter}}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                              </Border>
                              <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Column="1"
                            Style="{StaticResource InlineActionButtonStyle}"
                            Margin="10,0,0,0"
                            Content="{DynamicResource Common.Remove}"
                            AutomationProperties.Name="{DynamicResource Scan.RemoveRoot.AutomationName}"
                            VerticalAlignment="Top"
                            Command="{Binding RemoveScanRootCommand}" />
                  </Grid>
                </Grid>

                <StackPanel Grid.Column="2">
                  <Border Style="{StaticResource NeutralInfoCardBorderStyle}" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Scan.Compatibility}" Style="{StaticResource InfoLabelText}" />
                      <TextBlock Text="{Binding PathCompatibilitySummaryText}" Style="{StaticResource MicrocopyText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource NeutralInfoCardBorderStyle}">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Scan.Credentials}" Style="{StaticResource InfoLabelText}" />
                      <TextBlock Text="{Binding SelectedScanRootEffectiveCredentialSource}" Style="{StaticResource MicrocopyText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource NeutralInfoCardBorderStyle}" Padding="12,9" Margin="0,0,12,0">
              <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MicrocopyText}" Margin="0" TextWrapping="Wrap" />
            </Border>

            <Border Grid.Column="1"
                    Background="{Binding ServiceBadgeBackground}"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    Style="{StaticResource StatusBadgeBorderStyle}">
              <TextBlock Text="{Binding ServiceBadgeText}" Foreground="White" FontWeight="SemiBold" />
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource WarningStatusBadgeBorderStyle}"
                    Margin="8,0,0,0"
                    Visibility="{Binding IsNotElevated, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="{DynamicResource Common.NonAdmin}" Foreground="{StaticResource WarningTextBrush}" FontWeight="SemiBold" />
            </Border>
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="16,14,16,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" MinWidth="246" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:FolderTreePanel Grid.Column="0" />
        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />
        <views:ResultsPanel Grid.Column="2" />
      </Grid>
    </Grid>

    <!-- Backdrop overlay with animation -->
    <Border Panel.ZIndex="100">
      <Border.InputBindings>
        <MouseBinding MouseAction="LeftClick" Command="{Binding CloseSettingsCommand}" />
      </Border.InputBindings>
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Setter Property="Background" Value="#000F172A" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                    To="#540F172A" Duration="0:0:0.22">
                      <ColorAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                      </ColorAnimation.EasingFunction>
                    </ColorAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                    To="#000F172A" Duration="0:0:0.18">
                      <ColorAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn" />
                      </ColorAnimation.EasingFunction>
                    </ColorAnimation>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:0.18">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>

      <Grid x:Name="SettingsDrawer" HorizontalAlignment="Right" Width="460" MaxWidth="460" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RenderTransform>
          <TranslateTransform X="460" />
        </Grid.RenderTransform>
        <Grid.Style>
          <Style TargetType="Grid">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                <DataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                       From="460" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                          <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                       To="460" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction>
                          <QuadraticEase EasingMode="EaseIn" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.ExitActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,14">
          <DockPanel LastChildFill="False">
            <TextBlock Text="{DynamicResource Main.Settings}" Style="{StaticResource SectionHeaderText}" Margin="0" DockPanel.Dock="Left" />
            <Button Style="{StaticResource SecondaryActionButtonStyle}"
                    MinWidth="92"
                    IsCancel="True"
                    Command="{Binding CloseSettingsCommand}">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Common.Close}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DockPanel>
        </Border>
        <views:SettingsPanel Grid.Row="1"
                             Margin="16"
                             Visibility="{Binding IsNotViewerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </Grid>
    </Border>

    <Border Background="#800F172A" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border Background="{StaticResource SurfaceBrush}" Padding="24" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{DynamicResource Common.OperationInProgress}" FontWeight="SemiBold" Margin="0,0,0,12" HorizontalAlignment="Center" />
          <ProgressBar Width="240" Height="16" IsIndeterminate="True" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
