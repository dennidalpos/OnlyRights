<Window x:Class="NtfsAudit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NtfsAudit.App.Views"
        Title="{DynamicResource App.Title}"
        Icon="Assets/OnlyRights.ico"
        Width="1180"
        Height="720"
        MinWidth="920"
        MinHeight="560"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft JhengHei UI, Yu Gothic UI"
        Closing="MainWindow_OnClosing">
  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid x:Name="ContentGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsEnabled="{Binding IsNotBusy}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="12" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0">
              <Button Style="{StaticResource ActionButtonStyle}" Content="{DynamicResource Main.StartAnalysis}" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" ToolTip="{DynamicResource Main.StartAnalysis.ToolTip}" />
              <Button Style="{StaticResource ActionButtonStyle}" Content="{DynamicResource Main.StopAndClean}" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" ToolTip="{DynamicResource Main.StopAndClean.ToolTip}" />
              <Button Style="{StaticResource ActionButtonStyle}" Content="{DynamicResource Main.ImportAnalysis}" Command="{Binding ImportAnalysisCommand}" IsEnabled="{Binding CanImportAnalysis}" ToolTip="{DynamicResource Main.ImportAnalysis.ToolTip}" />
              <Button Style="{StaticResource ActionButtonStyle}" Content="{DynamicResource Main.ExportExcel}" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}" ToolTip="{DynamicResource Main.ExportExcel.ToolTip}" />
              <Button Style="{StaticResource ActionButtonStyle}" Content="{DynamicResource Main.CleanupResiduals}" Command="{Binding CleanupResidualFilesCommand}" ToolTip="{DynamicResource Main.CleanupResiduals.ToolTip}" Visibility="{Binding IsNotViewerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </WrapPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource ActionButtonStyle}"
                    Margin="12,0,0,6"
                    Content="{DynamicResource Main.Settings}"
                    Command="{Binding ToggleSettingsCommand}"
                    Visibility="{Binding IsNotViewerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </Grid>

          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <Border Background="#FFF7F9FB" BorderBrush="#FFD7DEE5" BorderThickness="1" Padding="10" CornerRadius="4" Visibility="{Binding IsNotViewerMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="{DynamicResource Scan.FoldersToScan}" Style="{StaticResource SubsectionHeaderText}" Margin="0,0,0,6" />
                  <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource InlineActionButtonStyle}" Margin="0,0,8,0" Content="{DynamicResource Common.Browse}" Command="{Binding BrowseCommand}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Style="{StaticResource InlineActionButtonStyle}" Margin="8,0,0,0" Content="{DynamicResource Common.Add}" Command="{Binding AddScanRootCommand}" />
                  </Grid>
                  <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" Height="84" ItemsSource="{Binding ScanRoots}" SelectedItem="{Binding SelectedScanRoot}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="4" Margin="0,1" CornerRadius="3" Background="{Binding Converter={StaticResource ScanRootPathKindBrushConverter}}">
                            <DockPanel>
                              <Border Background="#FF37474F" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" DockPanel.Dock="Right">
                                <TextBlock Text="{Binding Converter={StaticResource ScanRootPathKindLabelConverter}}" Foreground="White" FontSize="10" />
                              </Border>
                              <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Column="1" Style="{StaticResource InlineActionButtonStyle}" Margin="8,0" Content="{DynamicResource Common.Remove}" VerticalAlignment="Top" Command="{Binding RemoveScanRootCommand}" />
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{Binding PathCompatibilitySummaryText}" Style="{StaticResource MicrocopyText}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SelectedScanRootEffectiveCredentialSource}" Style="{StaticResource MicrocopyText}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ServiceScheduleSummaryText}" Style="{StaticResource MicrocopyText}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>

              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Border Background="{Binding ServiceBadgeBackground}" BorderBrush="#FFCFD8DC" Style="{StaticResource StatusBadgeBorderStyle}">
                  <TextBlock Text="{Binding ServiceBadgeText}" Foreground="White" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="{Binding ServiceRuntimeStatusText}" Style="{StaticResource MicrocopyText}" Margin="12,4,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
              <Border Background="#FFFFF3CD" BorderBrush="#FFFFEEBA" Style="{StaticResource StatusBadgeBorderStyle}" Padding="8,3"
                      HorizontalAlignment="Right"
                      Visibility="{Binding IsNotElevated, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{DynamicResource Common.NonAdmin}" Foreground="#FF856404" FontWeight="SemiBold" />
              </Border>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="290" MinWidth="240" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:FolderTreePanel Grid.Column="0" />
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FFE0E0E0" />
        <views:ResultsPanel Grid.Column="2" />
      </Grid>
    </Grid>

    <Border Background="#66000000"
            Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid HorizontalAlignment="Right" Width="420" MaxWidth="420" Background="White">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="12,12,12,0">
          <TextBlock Text="{DynamicResource Main.Settings}" Style="{StaticResource SectionHeaderText}" DockPanel.Dock="Left" />
          <Button Content="{DynamicResource Common.Close}" Width="88" HorizontalAlignment="Right" Command="{Binding CloseSettingsCommand}" />
        </DockPanel>
        <views:SettingsPanel Grid.Row="1"
                             Margin="12"
                             Visibility="{Binding IsNotViewerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </Grid>
    </Border>

    <Border Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border Background="White" Padding="24" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{DynamicResource Common.OperationInProgress}" FontWeight="SemiBold" Margin="0,0,0,12" HorizontalAlignment="Center" />
          <ProgressBar Width="240" Height="16" IsIndeterminate="True" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
